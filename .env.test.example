# Application
APP_NAME=FastAPI Microservice Template
APP_VERSION=1
DEBUG=false
PORT=8000
API_PREFIX=/api/v1
SHUTDOWN_TIMEOUT=5

# Database (test database)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_microservice_test
DATABASE_ECHO=false
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=60

# NATS JetStream
NATS_URL=nats://localhost:4222
NATS_CLIENT_NAME=fastapi-template-microservice-test
NATS_SUBJECT_PREFIX=templates
NATS_STREAM_PREFIX=template
NATS_TIMEOUT=5
NATS_ACK_WAIT_SECONDS=30
NATS_MAX_MESSAGES=1000
NATS_MAX_DELIVER=3
NATS_MAX_RECONNECT_ATTEMPTS=1
NATS_RECONNECT_TIME_WAIT=1

# Logging
LOG_LEVEL=warning
LOG_JSON=false

# CORS
CORS_ENABLED=false
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
THROTTLE_LIMIT=1000/minute

# Metrics
METRICS_ENABLED=false

# Tracing
OTEL_ENABLED=false
OTEL_SERVICE_NAME=fastapi-template-microservice
